# VM36 pulls the read-only Sidecar export and updates only competition slots.
CFIP_AUTO_SYNC_APPLY=0
CFIP_AUTO_SYNC_RECORDS="auto3.example.com auto4.example.com"
CFIP_AUTO_SYNC_PRIMARY_RECORDS="auto.example.com auto1.example.com auto2.example.com"
CFIP_AUTO_SYNC_MAX_CANARIES=3
CFIP_AUTO_SYNC_MIN_MBPS=3.5
CFIP_AUTO_SYNC_PRIMARY_MIN_MBPS=4.0
CFIP_AUTO_SYNC_PRIMARY_IMPROVEMENT_PERCENT=25
# Must remain disabled until a separate three-day production acceptance.
CFIP_AUTO_SYNC_PRIMARY_PROMOTION_APPLY=0
CFIP_ROUTER_CANARY_REQUIRED_DAYS=3
